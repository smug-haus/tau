diff --git a/test/tau/settings/loader_test.exs b/test/tau/settings/loader_test.exs
index 545db4d..4de111c 100644
--- a/test/tau/settings/loader_test.exs
+++ b/test/tau/settings/loader_test.exs
@@ -1,8 +1,14 @@
 defmodule Tau.Settings.LoaderTest do
   use ExUnit.Case, async: true
+  use ExUnitProperties
 
   alias Tau.Settings.Loader
 
+  # Keys that the loader treats specially: list values at these keys
+  # concatenate rather than right-bias. The right-bias property below
+  # avoids them; the disjoint-keys property does not need to.
+  @list_keys [:hooks, :extensions, :mcp, :allow, :deny, :ask, :permissions]
+
   describe "merge/2" do
     test "later overrides earlier scalars" do
       assert Loader.merge(%{model: "a"}, %{model: "b"}) == %{model: "b"}
@@ -30,5 +36,67 @@ defmodule Tau.Settings.LoaderTest do
       merged = Loader.merge(a, b)
       assert merged[:permissions][:deny] == ["Bash(rm *)", "Bash(sudo *)"]
     end
+
+    # Atom keys outside the special list-keys set, so neither the
+    # list-concat nor the recursive-map branch of merge_value/3 fires.
+    # Generated as :"k_<int>" to stay clear of @list_keys.
+    defp neutral_key_gen do
+      StreamData.bind(StreamData.positive_integer(), fn n ->
+        StreamData.constant(String.to_atom("k_#{n}"))
+      end)
+    end
+
+    # Scalar values only: avoids the list-concat and map-recursion
+    # branches so right-bias is the sole semantics at every conflict.
+    defp scalar_value_gen do
+      StreamData.one_of([
+        StreamData.integer(),
+        StreamData.boolean(),
+        StreamData.binary(),
+        StreamData.atom(:alphanumeric)
+      ])
+    end
+
+    defp flat_scalar_map_gen do
+      StreamData.map_of(neutral_key_gen(), scalar_value_gen(), max_length: 8)
+    end
+
+    @tag :property
+    property "merge/2 is commutative when top-level keysets are disjoint" do
+      # Any value shape is fine here: with disjoint keys, Map.merge/3's
+      # conflict callback never fires, so deep-merge semantics are
+      # irrelevant to the result.
+      check all(
+              a <- flat_scalar_map_gen(),
+              b <- flat_scalar_map_gen()
+            ) do
+        disjoint_b = Map.drop(b, Map.keys(a))
+        assert Loader.merge(a, disjoint_b) == Loader.merge(disjoint_b, a)
+      end
+    end
+
+    @tag :property
+    property "merge/2 is right-biased on conflicting scalar leaves at non-list keys" do
+      # Scope: flat maps, scalar leaves, atom keys outside @list_keys.
+      # Under those constraints every conflicting key takes b's value.
+      # Note: the loader is NOT universally right-biased — at the keys in
+      # @list_keys, list values concatenate (a ++ b). That branch is
+      # exercised by the example tests above; this property pins the
+      # right-bias semantics for the remaining (much larger) leaf space.
+      check all(
+              a <- flat_scalar_map_gen(),
+              b <- flat_scalar_map_gen()
+            ) do
+        # Defensive: generator already excludes @list_keys, but assert it
+        # so a generator regression surfaces as a clear failure here.
+        refute Enum.any?(Map.keys(a) ++ Map.keys(b), &(&1 in @list_keys))
+
+        merged = Loader.merge(a, b)
+
+        for {k, v} <- b do
+          assert Map.fetch!(merged, k) == v
+        end
+      end
+    end
   end
 end
