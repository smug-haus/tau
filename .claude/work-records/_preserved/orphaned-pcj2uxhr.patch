@@ -0,0 +1,230 @@
+defmodule Tau.Session.TurnTelemetryTest do
+  @moduledoc """
+  Verifies the [:tau, :session, :turn, :start | :stop | :exception] span
+  emitted around a user-to-assistant turn.
+  """
+  use ExUnit.Case, async: false
+
+  import Tau.Test.SessionHelper, only: [start_session_for_test: 1]
+  alias Tau.Provider.Event
+  alias Tau.Session.Events, as: SE
+
+  # Provider that returns {:error, reason} synchronously from stream/3,
+  # triggering the :exception telemetry path in session.ex.
+  defmodule ErrorProvider do
+    @moduledoc false
+    @behaviour Tau.Provider
+
+    @impl true
+    def stream(_, _, _), do: {:error, :test_provider_error}
+
+    @impl true
+    def capabilities,
+      do: %{
+        thinking: false,
+        tools: false,
+        vision: false,
+        prompt_caching: false,
+        parallel_tools: false
+      }
+
+    @impl true
+    def default_model, do: "error"
+  end
+
+  setup do
+    tmp = Path.join(System.tmp_dir!(), "tau-turn-tel-#{System.unique_integer([:positive])}")
+    File.mkdir_p!(tmp)
+    Application.put_env(:tau, :data_dir, tmp)
+
+    on_exit(fn ->
+      File.rm_rf!(tmp)
+      Application.delete_env(:tau, :data_dir)
+    end)
+
+    :ok
+  end
+
+  @fixture [
+    %Event.Start{request_id: "r0", model: "replay"},
+    %Event.TextStart{block_id: "b0"},
+    %Event.TextDelta{block_id: "b0", text: "hello"},
+    %Event.TextEnd{block_id: "b0"},
+    %Event.Done{stop_reason: :end_turn, usage: %{output_tokens: 1}}
+  ]
+
+  test ":start and :stop fire for a completed turn, :exception does not" do
+    sid = "turn-tel-#{System.unique_integer([:positive])}"
+    Phoenix.PubSub.subscribe(Tau.PubSub, "session:#{sid}")
+
+    test_pid = self()
+    handler_id = "tau-turn-telemetry-#{sid}"
+
+    :telemetry.attach_many(
+      handler_id,
+      [
+        [:tau, :session, :turn, :start],
+        [:tau, :session, :turn, :stop],
+        [:tau, :session, :turn, :exception]
+      ],
+      fn event, measurements, metadata, _ ->
+        send(test_pid, {:telemetry, event, measurements, metadata})
+      end,
+      nil
+    )
+
+    on_exit(fn -> :telemetry.detach(handler_id) end)
+
+    {:ok, ^sid} =
+      start_session_for_test(
+        provider: Tau.Providers.Replay,
+        session_id: sid,
+        provider_ctx: %{replay_fixture: @fixture}
+      )
+
+    Tau.send(sid, "hi")
+
+    assert_receive %SE.MessageEnd{}, 2_000
+
+    assert_receive {:telemetry, [:tau, :session, :turn, :start], _meas, start_meta}, 1_000
+    assert start_meta.session_id == sid
+
+    assert_receive {:telemetry, [:tau, :session, :turn, :stop], stop_meas, stop_meta}, 1_000
+    assert stop_meta.session_id == sid
+    assert is_integer(stop_meas.duration)
+    assert stop_meas.duration >= 0
+
+    refute_receive {:telemetry, [:tau, :session, :turn, :exception], _, _}, 100
+  end
+
+  # D-026 detection method: cancel mid-turn, send second turn, assert
+  # second :stop duration does not span the idle gap between turns.
+  test "cancel mid-turn closes span; second turn :stop duration is short" do
+    sid = "turn-tel-cancel-#{System.unique_integer([:positive])}"
+    Phoenix.PubSub.subscribe(Tau.PubSub, "session:#{sid}")
+
+    test_pid = self()
+    handler_id = "tau-turn-telemetry-cancel-#{sid}"
+
+    :telemetry.attach_many(
+      handler_id,
+      [
+        [:tau, :session, :turn, :start],
+        [:tau, :session, :turn, :stop],
+        [:tau, :session, :turn, :exception]
+      ],
+      fn event, measurements, metadata, _ ->
+        send(test_pid, {:telemetry, event, measurements, metadata})
+      end,
+      nil
+    )
+
+    on_exit(fn -> :telemetry.detach(handler_id) end)
+
+    # Slow fixture — 50ms per event. 7 events × 50ms = ~350ms total stream
+    # time. The cancel is sent after receiving MessageStart + MessageUpdate,
+    # so there is a structural guarantee the stream is in progress. The
+    # 5_000ms duration guard on the second turn is the real D-026 detector;
+    # it catches a stale turn_start_time regardless of cancel timing.
+    slow_fixture = [
+      %Event.Start{request_id: "r0", model: "replay"},
+      %Event.TextStart{block_id: "b0"},
+      %Event.TextDelta{block_id: "b0", text: "a"},
+      %Event.TextDelta{block_id: "b0", text: "b"},
+      %Event.TextDelta{block_id: "b0", text: "c"},
+      %Event.TextEnd{block_id: "b0"},
+      %Event.Done{stop_reason: :end_turn, usage: %{output_tokens: 3}}
+    ]
+
+    {:ok, ^sid} =
+      start_session_for_test(
+        provider: Tau.Providers.Replay,
+        session_id: sid,
+        provider_ctx: %{replay_fixture: slow_fixture, replay_delay_ms: 50}
+      )
+
+    # First turn — cancel mid-stream.
+    Tau.send(sid, "first")
+
+    assert_receive %SE.MessageStart{}, 1_000
+    assert_receive %SE.MessageUpdate{}, 1_000
+
+    Tau.cancel(sid)
+
+    # Structural assertions: start fired before cancel, exception fires with
+    # reason :cancelled. The :stop check is intentionally omitted here —
+    # whether :stop fires depends on whether the cancel races the stream end,
+    # which is timing-sensitive. The duration guard on the second turn is the
+    # structural D-026 detector.
+    assert_receive {:telemetry, [:tau, :session, :turn, :start], _, %{session_id: ^sid}}, 1_000
+
+    assert_receive {:telemetry, [:tau, :session, :turn, :exception], _exc_meas,
+                    %{session_id: ^sid, reason: :cancelled}},
+                   1_000
+
+    # Wait for the session to acknowledge the cancel before the second turn.
+    assert_receive %SE.Cancelled{}, 1_000
+
+    # Second turn — let it complete. The same slow fixture is reused;
+    # ~250ms of stream time is well under the 5_000ms idle-gap threshold.
+    Tau.send(sid, "second")
+
+    assert_receive %SE.MessageEnd{}, 3_000
+
+    assert_receive {:telemetry, [:tau, :session, :turn, :start], _, %{session_id: ^sid}}, 1_000
+
+    assert_receive {:telemetry, [:tau, :session, :turn, :stop], stop_meas, %{session_id: ^sid}},
+                   1_000
+
+    # Duration must NOT span the idle gap between turn 1 and turn 2.
+    # If turn_start_time was NOT cleared on cancel, t0 is from turn 1;
+    # the second stop subtracts it, yielding a duration that includes
+    # all idle time between turns — easily > 5_000ms in CI.
+    assert stop_meas.duration < 5_000,
+           "second :stop duration #{stop_meas.duration}ms spans idle gap — turn_start_time not cleared on cancel"
+  end
+
+  test ":start and :exception fire when provider returns {:error, reason}" do
+    sid = "turn-tel-exc-#{System.unique_integer([:positive])}"
+    Phoenix.PubSub.subscribe(Tau.PubSub, "session:#{sid}")
+
+    test_pid = self()
+    handler_id = "tau-turn-telemetry-exc-#{sid}"
+
+    :telemetry.attach_many(
+      handler_id,
+      [
+        [:tau, :session, :turn, :start],
+        [:tau, :session, :turn, :stop],
+        [:tau, :session, :turn, :exception]
+      ],
+      fn event, measurements, metadata, _ ->
+        send(test_pid, {:telemetry, event, measurements, metadata})
+      end,
+      nil
+    )
+
+    on_exit(fn -> :telemetry.detach(handler_id) end)
+
+    {:ok, ^sid} =
+      start_session_for_test(
+        provider: ErrorProvider,
+        session_id: sid
+      )
+
+    Tau.send(sid, "hi")
+
+    assert_receive %SE.MessageEnd{}, 2_000
+
+    assert_receive {:telemetry, [:tau, :session, :turn, :start], _meas, start_meta}, 1_000
+    assert start_meta.session_id == sid
+
+    assert_receive {:telemetry, [:tau, :session, :turn, :exception], exc_meas, exc_meta}, 1_000
+    assert exc_meta.session_id == sid
+    assert exc_meta.reason == :test_provider_error
+    assert is_integer(exc_meas.duration)
+    assert exc_meas.duration >= 0
+
+    refute_receive {:telemetry, [:tau, :session, :turn, :stop], _, _}, 100
+  end
+end
