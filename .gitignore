# Build artefacts
/_build/
/cover/
/deps/

# web/ poncho package build artefacts (issue #374)
/web/_build/
/web/deps/
/web/assets/node_modules/
/doc/
/.fetch
erl_crash.dump
*.ez
*.beam
.anthropic_api_key

# Releases & escripts
/tau
/tau.bat
/release/
/burrito_out/

# Mix
/.elixir_ls/
/.lexical/

# Dialyzer
/priv/plts/*.plt
/priv/plts/*.plt.hash

# Generated by `mix tau.gen.schema` from lib/tau/settings/schema.ex
/priv/schemas/settings.schema.json

# Local config / secrets
/config/*.local.exs
.env
.env.*
!.env.example

# Editor noise
.DS_Store
.idea/
.vscode/
*.swp
*~

# Test coverage
/cover/
coverage.json

# Tau runtime data (when developing against the local cwd)
/.tau/settings.local.json

# Per-agent XDG_DATA_HOME (Burrito unpack-cache isolation, see worktree-discipline.md)
/.xdg-data/

# Scratch dir used by some mix tasks
/tmp/

# Claude Code agent worktrees (created by Agent calls with isolation: "worktree")
/.claude/worktrees/

# hyperagents evolutionary archives — runtime output (each sibling is its own
# git repo); the system's product, not the system itself.
/.claude/hyperagents/

# Claude harness runtime state — observations, kill signals, solution tree.
# .gitkeep keeps the directory present in version control.
/.claude/logs/*
!/.claude/logs/.gitkeep
/.claude/settings.local.json

# factory-loop kill switch — an operator sentinel, never project state.
# See .claude/rules/factory-loop.md "Continuity and the kill switch".
/.claude/STOP-FACTORY

# Defensive: kill-signal and observations belong under .claude/logs/, but
# guard against any hook accidentally writing them at the repo root.
/kill-signal.json
/observations.jsonl

# Python bytecode from the harness's hook scripts (heuristic-monitor, parsers).
__pycache__/
*.pyc

# Per-developer Python venv (see CONTRIBUTING.md "Build prerequisites").
# `.python-version` IS committed (pyenv reads it); `.venv/` is not.
/.venv/
