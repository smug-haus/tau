# Build artefacts
/_build/
/cover/
/deps/
/doc/
/.fetch
erl_crash.dump
*.ez
*.beam

# Releases & escripts
/tau
/tau.bat
/release/
/burrito_out/

# Mix
/.elixir_ls/
/.lexical/

# Dialyzer
/priv/plts/*.plt
/priv/plts/*.plt.hash

# Generated by `mix tau.gen.schema` from lib/tau/settings/schema.ex
/priv/schemas/settings.schema.json

# Local config / secrets
/config/*.local.exs
.env
.env.*
!.env.example

# Editor noise
.DS_Store
.idea/
.vscode/
*.swp
*~

# Test coverage
/cover/
coverage.json

# Tau runtime data (when developing against the local cwd)
/.tau/settings.local.json

# Claude Code agent worktrees (created by Agent calls with isolation: "worktree")
/.claude/worktrees/

# Claude harness runtime state — observations, kill signals, solution tree.
# .gitkeep keeps the directory present in version control.
/.claude/logs/*
!/.claude/logs/.gitkeep
/.claude/settings.local.json

# Defensive: kill-signal and observations belong under .claude/logs/, but
# guard against any hook accidentally writing them at the repo root.
/kill-signal.json
/observations.jsonl

# Python bytecode from the harness's hook scripts (heuristic-monitor, parsers).
__pycache__/
*.pyc

# Per-developer Python venv (see CONTRIBUTING.md "Build prerequisites").
# `.python-version` IS committed (pyenv reads it); `.venv/` is not.
/.venv/
